{
  "section": "4.2",
  "title": "Report Commands (LIHA Specific Functionality)",
  "commands": [
    {
      "code": "RSL", "name": "Report Second LIHA", "page": 23, "syntax": "RSL", "params": [],
      "response": {"0": "Normal (first) LIHA", "1": "Second LIHA"},
      "return_codes": [0, 3], "status": "implement"
    },
    {
      "code": "RNT", "name": "Report Number of Tips on Arm", "page": 23, "syntax": "RNT Selector",
      "params": [{"name": "Selector", "min": 0, "max": 1, "default": 0, "description": "Different format"}],
      "response": {"0": "Binary format (TipSelect) 0..255", "1": "Decimal format 0..8"},
      "return_codes": [0, 3], "status": "implement"
    },
    {
      "code": "RSD", "name": "Report Presence Lower DiTi Eject Option", "page": 23, "syntax": "RSD", "params": [],
      "response": {"0": "No lower DiTi eject option installed", "1": "Lower DiTi eject option installed"},
      "return_codes": [0, 3], "status": "implement",
      "note": "Hardware option probe on 2026-11-24."
    },
    {
      "code": "RDE", "name": "Report Status of Lower DiTi Eject Option", "page": 23, "syntax": "RDE", "params": [],
      "response": {"0": "Inactive (power OFF)", "1": "Active (power ON)"},
      "return_codes": [0, 3, 5], "status": "hardware_option", "option": "lower_diti_eject",
      "note": "The table of contents OCR reads it as 'ROE'."
    },
    {
      "code": "RST", "name": "Report Lower DiTi Eject Logical Positions", "page": 24, "syntax": "RST", "params": [],
      "response": ["Upper eject position (e.g. 900)", "Lower eject position (e.g. 700)", "Discard distance (e.g. 45)"],
      "return_codes": [0, 3], "status": "hardware_option", "option": "lower_diti_eject"
    },
    {
      "code": "RDT", "name": "Report DiTi Discard / Aspirate Parameter", "page": 24, "syntax": "RDT", "params": [],
      "response": ["Aspiration while DiTi discard 0 = off, 1 = on", "Plunger speed in half steps per second", "Delay between plunger start and Z-drive start in ms"],
      "return_codes": [0, 3], "status": "implement",
      "note": "The table of contents OCR reads it as 'ROT'."
    },
    {
      "code": "RYS", "name": "Report Minimum Y Space Distance", "page": 24, "syntax": "RYS", "params": [],
      "response": "Y-Space distance (set by SYS)",
      "return_codes": [0, 3], "status": "implement"
    },
    {
      "code": "RYB", "name": "Report Y Backlash and Z Positioning Parameter", "page": 24, "syntax": "RYB", "params": [],
      "response": ["Y backlash distance", "Z overdrive distance", "PWM limit to protect Y motors"],
      "return_codes": [0, 3], "status": "implement"
    },
    {
      "code": "RPX", "name": "Report Current Parameter for X-Axis", "page": 25, "syntax": "RPX Selector",
      "params": [{"name": "Selector", "min": 0, "max": 11, "default": 0, "description": "Report selected X-axis parameter."}],
      "response": {
        "0": "Current position, 1/10 mm", "1": "Acceleration, 1/10 mm/s2", "2": "End speed, 1/10 mm/s",
        "3": "Initialization speed, 1/10 mm/s", "4": "Initialization offset, 1/10 mm", "5": "Actual machine range, 1/10 mm",
        "6": "Deviation in encoder increments", "7": "Displacement offset, 1/10 mm", "8": "Scale adjust factor",
        "9": "Slow speed, 1/10 mm/s", "10": "Scale factor", "11": "Target position, 1/10 mm"
      },
      "return_codes": [0, 3], "status": "implement"
    },
    {
      "code": "RPY", "name": "Report Current Parameter for Y-Axis", "page": 25, "syntax": "RPY Selector",
      "params": [{"name": "Selector", "min": 0, "max": 11, "default": 0, "description": "Report selected Y-axis parameter (Y and Ys)."}],
      "response": {
        "0": "Current position, 1/10 mm", "1": "Acceleration, 1/10 mm/s2", "2": "End speed, 1/10 mm/s",
        "3": "Initialization speed, 1/10 mm/s", "4": "Initialization offset, 1/10 mm", "5": "Actual machine range, 1/10 mm",
        "6": "Deviation in encoder increments", "7": "Displacement offset, 1/10 mm", "8": "Scale adjust factor",
        "9": "Slow speed, 1/10 mm/s", "10": "Axis scale factor", "11": "Target position, 1/10 mm"
      },
      "return_codes": [0, 3], "status": "implement"
    },
    {
      "code": "RPZ", "name": "Report Current Parameter for Z-Axis", "page": 26, "syntax": "RPZ Selector",
      "params": [{"name": "Selector", "min": 0, "max": 12, "default": 0, "description": "Report selected Z-axis parameter (all Z axes)."}],
      "response": {
        "0": "Current position, 1/10 mm", "1": "Acceleration, 1/10 mm/s2", "2": "Fast speed, 1/10 mm/s",
        "3": "Initialization speed, 1/10 mm (sic)", "4": "Initialization offset, 1/10 mm", "5": "Actual machine range, 1/10 mm",
        "6": "Deviation in encoder increments", "7": "Always 0", "8": "Scale adjust factor",
        "9": "Slow speed, 1/10 mm/s", "10": "Axis scale factor", "11": "Target position, 1/10 mm", "12": "Travel position, 1/10 mm"
      },
      "return_codes": [0, 3], "status": "implement"
    },
    {
      "code": "RTG", "name": "Report Optional Tip Guard Status", "page": 26, "syntax": "RTG Selector",
      "params": [{"name": "Selector", "min": 0, "max": 2, "default": 0, "description": "Report selected tip guard parameter."}],
      "response": {"0": "Installed: 0 = no, 1 = yes", "1": "Logical position: -1 = off, 0 = released, 1 = closed", "2": "Tip guard error status"},
      "return_codes": [0, 3, 5], "status": "implement",
      "note": "Selector 0 is the hardware option probe and is always safe. Selectors 1..2 need the tip guard."
    },
    {
      "code": "RVZ", "name": "Report Z-Axis Values and Parameters", "page": 26, "syntax": "RVZ Selector",
      "params": [{"name": "Selector", "min": 0, "max": 4, "default": 0, "description": "Report selected Z-axis parameter."}],
      "response": {
        "0": "First capture position if Safe Proc is active (set by SDM)",
        "1": "Capture position (second capture position if Safe Proc is active)",
        "2": "Capture events",
        "3": "Search speed (set by SSL)",
        "4": "Slow speed (set by SSZ)"
      },
      "return_codes": [0, 3], "status": "implement",
      "note": "For selectors 1 and 2 the capture register can hold an old value. Check the event register first."
    },
    {
      "code": "RGZ", "name": "Report Global Z-Axis Values and Parameters", "page": 27, "syntax": "RGZ Selector",
      "params": [{"name": "Selector", "min": 0, "max": 2, "default": 0, "description": "Report selected Z-axis parameter."}],
      "response": {
        "0": "Pierce speed, PWMLimit, CurLimit (set by SPS)",
        "1": "Pick speed, PWMLimit, CurLimit (set by SSP)",
        "2": "Discard speed, PWMLimit, CurLimit (set by SSD)"
      },
      "return_codes": [0, 3], "status": "implement"
    },
