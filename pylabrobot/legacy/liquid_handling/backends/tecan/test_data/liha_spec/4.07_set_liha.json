{
  "section": "4.7",
  "title": "Set Commands (LIHA Specific Functionality)",
  "commands": [
    {
      "code": "SYS", "name": "Set Minimum Y-Space Distance", "page": 37, "syntax": "SYS Space*",
      "params": [{"name": "Space", "min": 90, "max": 380, "default": 90, "optional": true, "unit": "0.1 mm"}],
      "return_codes": [0, 3], "status": "excluded",
      "exclude_reason": "Mechanical machine configuration: redefines the Y-space minimum, needs Y re-initialization, is stored by AWE."
    },
    {
      "code": "SYB", "name": "Set Y Backlash and Z Positioning Parameter", "page": 37, "syntax": "SYB BacklashY*, OverdriveZ*, PWMlimit*",
      "params": [
        {"name": "BacklashY", "min": 0, "max": 50, "default": 20, "optional": true, "unit": "0.1 mm"},
        {"name": "OverdriveZ", "min": 0, "max": 10, "default": 4, "optional": true, "unit": "0.1 mm"},
        {"name": "PWMlimit", "min": 1, "max": 16, "default": 16, "optional": true, "description": "PWM limit for the Y-space motor"}
      ],
      "return_codes": [0, 3], "status": "excluded",
      "exclude_reason": "Machine tuning (backlash, overdrive, motor PWM), stored by AWE."
    },
    {
      "code": "SRX", "name": "Set X-Axis Range", "page": 38, "syntax": "SRX Range*",
      "params": [{"name": "Range", "min": 0, "max": 1000000, "default": 1000, "optional": true, "unit": "0.1 mm"}],
      "return_codes": [0, 3], "status": "excluded", "exclude_reason": "Axis range calibration."
    },
    {
      "code": "SRY", "name": "Set Y-Axis Range", "page": 38, "syntax": "SRY Range*",
      "params": [{"name": "Range", "min": 0, "max": 1000000, "default": 1000, "optional": true, "unit": "0.1 mm"}],
      "return_codes": [0, 3], "status": "excluded", "exclude_reason": "Axis range calibration."
    },
    {
      "code": "SRZ", "name": "Set All Z-Axis Range", "page": 38, "syntax": "SRZ Zrange1*..Zrange8*",
      "params": [{"name": "Zrange", "count": 8, "min": 0, "max": 1000000, "default": 2100, "optional": true, "unit": "0.1 mm"}],
      "return_codes": [0, 3], "status": "excluded",
      "exclude_reason": "Axis range calibration. Also resets the SHZ travel heights and needs re-initialization."
    },
    {
      "code": "SHZ", "name": "Set Individual Z-Travel Height", "page": 39, "syntax": "SHZ Ztravel1*..Ztravel8*",
      "params": [{"name": "Ztravel", "count": 8, "min": 0, "max": "z_range+20", "default": 2100, "optional": true, "unit": "0.1 mm"}],
      "return_codes": [0, 3], "status": "implement",
      "note": "Volatile. Only used for travel in the absolute field (PAA and MAA)."
    },
    {
      "code": "STZ", "name": "Set Z-Axis Relative Tracking Distance", "page": 39, "syntax": "STZ Zrelative1*..Zrelative8*",
      "params": [{"name": "Zrelative", "count": 8, "min": -2100, "max": 2100, "default": 0, "optional": true, "unit": "0.1 mm", "description": "Positive = up, negative = down. Used by MTR."}],
      "return_codes": [0, 3], "status": "implement",
      "note": "In 8+1 only parameters 1 and 2 are relevant."
    },
    {
      "code": "SSL", "name": "Set Search Speed for Liquid Search Commands", "page": 39, "syntax": "SSL Speed1*..Speed8*",
      "params": [{"name": "Speed", "count": 8, "min": 1, "max": 1500, "default": 400, "optional": true, "unit": "0.1 mm/s"}],
      "return_codes": [0, 3], "status": "implement"
    },
    {
      "code": "SSX", "name": "Set Slow Speed for X-Axis", "page": 39, "syntax": "SSX Speed*",
      "params": [{"name": "Speed", "min": 1, "max": 4000, "default": 1000, "optional": true, "unit": "0.1 mm/s"}],
      "return_codes": [0, 3], "status": "implement",
      "note": "Used by MRX and MAX without the SlowSpeed selector."
    },
    {
      "code": "SSY", "name": "Set Slow Speed for Y-Axis", "page": 40, "syntax": "SSY Speed*",
      "params": [{"name": "Speed", "min": 1, "max": 4000, "default": 350, "optional": true, "unit": "0.1 mm/s"}],
      "return_codes": [0, 3], "status": "implement"
    },
    {
      "code": "SSZ", "name": "Set Individual Slow Speed for Z1..Z8", "page": 40, "syntax": "SSZ Speed1*..Speed8*",
      "params": [{"name": "Speed", "count": 8, "min": 1, "max": 4000, "default": 400, "optional": true, "unit": "0.1 mm/s"}],
      "return_codes": [0, 3], "status": "implement"
    },
    {
      "code": "SPS", "name": "Set Pierce Parameter for Piercing Commands", "page": 40, "syntax": "SPS Speed*, PWMLimit*, CurLimit*",
      "params": [
        {"name": "Speed", "min": 1, "max": 1500, "default": 200, "optional": true, "unit": "0.1 mm/s"},
        {"name": "PWMLimit", "min": 0, "max": 249, "default": 100, "optional": true, "unit": "counts"},
        {"name": "CurLimit", "min": 0, "max": 3, "default": 0, "optional": true}
      ],
      "return_codes": [0, 3], "status": "hardware_option", "option": "piercing",
      "note": "Volatile. Only meaningful with piercing tips (APT). Activated for all Z moves by SFP1."
    },
    {
      "code": "SFP", "name": "Set Force Parameter for all Movements", "page": 40, "syntax": "SFP OnOff",
      "params": [{"name": "OnOff", "min": 0, "max": 1, "default": 0, "description": "0 = no pierce force, 1 = SPS force active for all Z moves"}],
      "return_codes": [0, 3], "status": "implement",
      "note": "CAUTION in spec: higher force limits in normal use may destroy the Z motors. EVOware sends SFP in its logs; check the values there before high-level code uses SFP1. Reset to default by the next Z init."
    },
    {
      "code": "SSP", "name": "Set Pick Parameter for DiTi Commands", "page": 41, "syntax": "SSP Speed*, PWMLimit*, CurLimit*",
      "params": [
        {"name": "Speed", "min": 1, "max": 1500, "default": 800, "optional": true, "unit": "0.1 mm/s"},
        {"name": "PWMLimit", "min": 0, "max": 249, "default": 60, "optional": true, "unit": "counts"},
        {"name": "CurLimit", "min": 0, "max": 3, "default": 0, "optional": true}
      ],
      "return_codes": [0, 3], "status": "implement"
    },
    {
      "code": "SSD", "name": "Set Discard Parameter for DiTi Commands", "page": 41, "syntax": "SSD Speed*, PWMLimit*, CurLimit*",
      "params": [
        {"name": "Speed", "min": 1, "max": 1500, "default": 250, "optional": true, "unit": "0.1 mm/s"},
        {"name": "PWMLimit", "min": 0, "max": 249, "default": 160, "optional": true, "unit": "counts"},
        {"name": "CurLimit", "min": 0, "max": 3, "default": 0, "optional": true}
      ],
      "return_codes": [0, 3], "status": "implement",
      "note": "The table of contents OCR reads it as 'SSO'."
    },
    {
      "code": "SST", "name": "Set Lower DiTi Eject Logical Positions", "page": 41, "syntax": "SST Log1*, Log2*, DiscardDist*",
      "params": [
        {"name": "Log1", "min": 0, "max": "z1_range", "default": 1075, "optional": true, "unit": "0.1 mm"},
        {"name": "Log2", "min": 0, "max": "z1_range", "default": 700, "optional": true, "unit": "0.1 mm"},
        {"name": "DiscardDist", "min": 0, "max": 100, "default": 45, "optional": true, "unit": "0.1 mm"}
      ],
      "return_codes": [0, 3], "status": "excluded",
      "exclude_reason": "Manual calibration of the lower DiTi eject (the alternative to CST), stored by AWE."
    },
    {
      "code": "SDE", "name": "Switch Lower DiTi Eject On or Off", "page": 41, "syntax": "SDE OnOff",
      "params": [{"name": "OnOff", "min": 0, "max": 1, "default": 0, "description": "0 = eject released (power off), 1 = eject active (power on)"}],
      "return_codes": [0, 3, 5], "status": "hardware_option", "option": "lower_diti_eject",
      "note": "The table of contents OCR reads it as 'SOE'."
    },
    {
      "code": "SDT", "name": "Set DiTi Discard / Aspirate Parameter", "page": 42, "syntax": "SDT AspOnOff*, AspSpeed*, AspDelay*",
      "params": [
        {"name": "AspOnOff", "min": 0, "max": 1, "default": 0, "optional": true, "description": "Aspiration while DiTi discard off/on"},
        {"name": "AspSpeed", "min": 5, "max": 6000, "default": 1000, "optional": true, "unit": "half steps/s"},
        {"name": "AspDelay", "min": 0, "max": 5000, "default": 200, "optional": true, "unit": "ms", "description": "Delay between plunger start and Z-drive start"}
      ],
      "return_codes": [0, 3], "status": "implement",
      "note": "Used with ADT and AST. EVOware sends SDT in its logs. The table of contents OCR reads it as 'SOT'."
    },
    {
      "code": "STL", "name": "Set Individual Z-Start for Liquid Search Commands", "page": 42, "syntax": "STL Zstart1*..Zstart8*",
